CREATE TABLE temp_communces AS 
SELECT * FROM communces WHERE 1=0;


SET @row_number = 0;
INSERT INTO temp_communces (id,code, name, name_in_english, province_id, district_id)
SELECT
    (@row_number := @row_number + 1) AS id,  -- New sequential ID
    code,
    name,
    name_in_english,
    province_id,
    district_id
FROM communces;